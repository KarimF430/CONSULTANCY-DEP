{
    "info": {
        "_postman_id": "booking-api-tests",
        "name": "Booking API Tests",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Create Booking",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status is 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Success is true', function () {",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.success).to.be.true;",
                            "});",
                            "",
                            "pm.test('Has orderId', function () {",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.orderId).to.exist;",
                            "    pm.environment.set('ORDER_ID', json.orderId);",
                            "});",
                            "",
                            "pm.test('Response time < 3000ms', function () {",
                            "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Newman Test User\",\n  \"email\": \"newman@test.com\",\n  \"phone\": \"9876543210\",\n  \"planId\": 1,\n  \"planName\": \"Automated Test Plan\",\n  \"planPrice\": 999,\n  \"slotDate\": \"2025-02-15\",\n  \"slotTime\": \"10:00 AM\",\n  \"paymentMethod\": \"upi\"\n}"
                },
                "url": {
                    "raw": "http://localhost:3000/api/bookings",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3000",
                    "path": [
                        "api",
                        "bookings"
                    ]
                }
            }
        },
        {
            "name": "Get All Bookings",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status is 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Returns bookings array', function () {",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.bookings).to.be.an('array');",
                            "});",
                            "",
                            "pm.test('Has count field', function () {",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.count).to.be.a('number');",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "http://localhost:3000/api/bookings",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3000",
                    "path": [
                        "api",
                        "bookings"
                    ]
                }
            }
        },
        {
            "name": "Missing Fields - Should Fail",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status is 400', function () {",
                            "    pm.response.to.have.status(400);",
                            "});",
                            "",
                            "pm.test('Has error message', function () {",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.error).to.exist;",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Only Name\"\n}"
                },
                "url": {
                    "raw": "http://localhost:3000/api/bookings",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3000",
                    "path": [
                        "api",
                        "bookings"
                    ]
                }
            }
        }
    ]
}